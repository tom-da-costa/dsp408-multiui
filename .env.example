# Copy to .env and adjust, then: docker compose up -d
# (before 0.8 these were named DSP408_*: rename them; the old names still work for now)
TRACKS_DSP_HOST=192.168.1.50        # IP address of the DSP
TRACKS_DSP_PIN=0000                 # access code for the web UI: change it!
TRACKS_DSP_LISTEN_PORT=8080         # port of the web UI on this machine
TRACKS_DSP_METER_RATE=5             # meter refresh rate, 1-10 Hz
TRACKS_DSP_LOCK_IDLE_TIMEOUT=120    # seconds of inactivity before the lock is released
TRACKS_DSP_RESYNC_INTERVAL=0        # re-read the DSP config every N seconds (0 = off)
TRACKS_DSP_EXPERIMENTAL=false       # allow parameters not yet verified on a DSP 408
TRACKS_DSP_DEMO=false               # true = demo mode without a DSP (simulated inside the app)
TRACKS_DSP_MODEL=auto               # DSP model: auto (detected), 408, 206 or 204
TRACKS_DSP_DEVICE_ID=               # the DSP's ID number (front panel, 1-250); empty = searched for
TRACKS_DSP_LOG_LEVEL=info
# HTTPS on the same port (plain http is redirected), either:
TRACKS_DSP_TLS_SELF_SIGNED=false    # true = generate a self-signed certificate (browsers ask once)
TRACKS_DSP_TLS_NAMES=               # address(es) the browsers use, e.g. 192.168.1.10,dsp.local
# or your own certificate (mount ./certs, see compose.yaml):
# TRACKS_DSP_TLS_CERT=/certs/cert.pem
# TRACKS_DSP_TLS_KEY=/certs/key.pem
# TRACKS_DSP_IMAGE=ghcr.io/tom-da-costa/tracks-dsp-controller:latest   # use the published image
