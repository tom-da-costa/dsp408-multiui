# Copy to .env and adjust, then: docker compose up -d
# (before 0.8 these were named DSP408_*: rename them; the old names still work for now)
TDSP_HOST=192.168.1.50          # IP address of the DSP
TDSP_PIN=0000                   # access code for the web UI: change it!
TDSP_LISTEN_PORT=8080           # port of the web UI on this machine
TDSP_METER_RATE=5               # meter refresh rate, 1-10 Hz
TDSP_LOCK_IDLE_TIMEOUT=120      # seconds of inactivity before the lock is released
TDSP_RESYNC_INTERVAL=0          # re-read the DSP config every N seconds (0 = off)
TDSP_EXPERIMENTAL=false         # allow parameters not yet verified on a DSP 408
TDSP_DEMO=false                 # true = demo mode without a DSP (simulated inside the app)
TDSP_MODEL=auto                 # DSP model: auto (detected), 408, 206 or 204
TDSP_DEVICE_ID=                 # the DSP's ID number (front panel, 1-250); empty = searched for
TDSP_LOG_LEVEL=info
# HTTPS on the same port (plain http is redirected), either:
TDSP_TLS_SELF_SIGNED=false      # true = generate a self-signed certificate (browsers ask once)
TDSP_TLS_NAMES=                 # address(es) the browsers use, e.g. 192.168.1.10,dsp.local
# or your own certificate (mount ./certs, see compose.yaml):
# TDSP_TLS_CERT=/certs/cert.pem
# TDSP_TLS_KEY=/certs/key.pem
# TDSP_IMAGE=ghcr.io/tom-da-costa/tracks-dsp-controller:latest   # use the published image
