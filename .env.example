# Copy to .env and adjust, then: docker compose up -d
DSP408_HOST=192.168.1.50        # IP address of the DSP 408
DSP408_PIN=0000                 # access code for the web UI: change it!
DSP408_LISTEN_PORT=8080         # port of the web UI on this machine
DSP408_METER_RATE=5             # meter refresh rate, 1-10 Hz
DSP408_LOCK_IDLE_TIMEOUT=120    # seconds of inactivity before the lock is released
DSP408_RESYNC_INTERVAL=0        # re-read the DSP config every N seconds (0 = off)
DSP408_EXPERIMENTAL=false       # allow parameters not yet verified on a DSP 408
DSP408_DEMO=false               # true = demo mode without a DSP (simulated inside the app)
DSP408_MODEL=auto               # DSP model: auto (detected), 408, 206 or 204
DSP408_LOG_LEVEL=info
# HTTPS on the same port (plain http is redirected), either:
DSP408_TLS_SELF_SIGNED=false    # true = generate a self-signed certificate (browsers ask once)
DSP408_TLS_NAMES=               # address(es) the browsers use, e.g. 192.168.1.10,dsp.local
# or your own certificate (mount ./certs, see compose.yaml):
# DSP408_TLS_CERT=/certs/cert.pem
# DSP408_TLS_KEY=/certs/key.pem
# DSP408_IMAGE=ghcr.io/tom-da-costa/tracks-dsp-controller:latest   # use the published image
